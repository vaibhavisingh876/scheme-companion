generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scheme {
  id                     String       @id @default(cuid())
  name                   String
  description            String       @db.Text
  benefits               String       @db.Text
  eligibility            String       @db.Text

  category               String?
  ministry               String?
  state                  String?
  gender                 String?
  occupation             String?
  educationLevel         String?

  allowedCategories      String[]
  allowedStates          String[]
  allowedGenders         String[]
  allowedOccupations     String[]
  allowedEducationLevels String[]

  minIncome              Int?
  maxIncome              Int?
  minAge                 Int?
  maxAge                 Int?

  applicationLink        String?
  sourceUrl              String?
  tags                   String[]
  documentsRequired      String?      @db.Text

  externalId             String
  sourceId               String
  checksum               String
  version                Int          @default(1)
  isActive               Boolean      @default(true)
  lastSyncedAt           DateTime?
  isScholarship          Boolean      @default(false)
  isFemaleOnly           Boolean      @default(false)
  schemeFor              String?

  source                 SchemeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  groqEligibility        GroqEligibilityRule?

  descriptionEmbedding   Float[]      @default([])
  eligibilityEmbedding   Float[]      @default([])

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([state])
  @@index([occupation])
  @@index([educationLevel])
  @@index([minIncome])
  @@index([maxIncome])
  @@index([minAge])
  @@index([maxAge])
  @@index([category])
  @@index([ministry])
  @@index([isActive])
  @@index([allowedCategories])
  @@index([allowedStates])
  @@index([allowedGenders])
  @@index([allowedOccupations])
  @@index([allowedEducationLevels])

  @@unique([sourceId, externalId])

  bookmarks Bookmark[]
}

model SchemeSource {
  id          String    @id
  name        String    @unique
  sourceUrl   String
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())

  schemes     Scheme[]
}

model RawScheme {
  id          String   @id @default(cuid())
  source      String
  externalId  String?
  payload      Json
  fetchedAt   DateTime @default(now())
}

model SyncJob {
  id             String    @id @default(cuid())
  source         String
  status         String
  startedAt      DateTime
  finishedAt     DateTime?
  recordsRead    Int       @default(0)
  recordsAdded   Int       @default(0)
  recordsUpdated Int       @default(0)
  error          Json?
  createdAt      DateTime  @default(now())
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  bookmarks Bookmark[]
  createdAt DateTime   @default(now())
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  schemeId  String
  user      User     @relation(fields: [userId], references: [id])
  scheme    Scheme   @relation(fields: [schemeId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, schemeId])
}

// Detailed eligibility rules extracted by Groq from a scheme's raw eligibility
// text. Deliberately separate from Scheme's normalized columns, which remain
// the source of truth for manual filters. A row exists only after an actual
// Groq call for that scheme; bulk ingestion never populates this table.
//
// sourceHash is a hash of the exact eligibility text used for extraction. If
// the source text changes, the row is deleted during sync and the next
// recommendation request re-extracts on demand. The FK cascade guarantees a
// deleted scheme cannot leave orphaned AI rules behind.
model GroqEligibilityRule {
  id               String   @id @default(cuid())
  schemeId         String   @unique
  scheme           Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eligibilityRules Json?
  sourceHash       String
  status           String   @default("pending") // success | failed | pending
  modelVersion     String   @default("unknown")
  attempts         Int      @default(0)
  lastError        String?
  extractedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([sourceHash])
  @@map("GroqEligibilityRules")
}